#!/bin/bash
ln -sf /opt/nfdtonfc/bin/nfdtonfc /usr/local/bin/nfdtonfc

mkdir -p /usr/local/share/man/man1
cat <<'EOF' | gzip > /usr/local/share/man/man1/nfdtonfc.1.gz
.TH NFDTONFC 1 "2026" "1.0.0" "User Commands"
.SH NAME
nfdtonfc \- convert filenames from NFD to NFC Unicode normalization
.SH SYNOPSIS
.B nfdtonfc
[\fB\-f\fR | \fB\-\-force\fR]
[\fB\-\-help\fR]
[\fB\-\-version\fR]
\fI<file-or-directory>\fR
[\fI<file-or-directory>\fR ...]
.SH DESCRIPTION
.B nfdtonfc
renames files and directories whose names are encoded in NFD (Canonical Decomposition) Unicode normalization form to NFC (Canonical Composition) form.
.PP
This is particularly useful on macOS, where the HFS+ filesystem stores filenames in NFD, causing issues when files are shared with Linux or Windows systems that expect NFC filenames.
.PP
When a directory is specified, it is processed recursively. Deepest paths are renamed first to avoid broken references caused by parent directory renames.
.SH OPTIONS
.TP
.B \-f, \-\-force
Overwrite existing files without prompting.
.TP
.B \-\-help
Show a help message and exit.
.TP
.B \-\-version
Show the version and exit.
.SH ARGUMENTS
.TP
.I <file-or-directory>
One or more files or directories to process. Directories are traversed recursively.
.SH EXAMPLES
.TP
Convert a single file:
.B nfdtonfc file.txt
.TP
Convert all files in a directory recursively:
.B nfdtonfc ~/Downloads
.TP
Convert multiple targets at once:
.B nfdtonfc dir1 dir2 file.txt
.SH EXIT STATUS
.TP
.B 0
Success.
.TP
.B 1
No arguments were provided.
.SH AUTHOR
xorwnsnmnnhlba
.SH SEE ALSO
.BR mv (1),
.BR find (1)
EOF

mandb -q

# Nautilus(GNOME Files) 우클릭 메뉴 등록 - 실제 로그인 사용자 전부 + 향후 생성될 사용자(/etc/skel)
NAUTILUS_SCRIPT_SRC="$(find /opt/nfdtonfc -name nautilus-script -type f | head -n1)"
if [ -n "$NAUTILUS_SCRIPT_SRC" ]; then
    install_nautilus_script() {
        local home="$1"
        local dest_dir="$home/.local/share/nautilus/scripts"
        mkdir -p "$dest_dir"
        cp "$NAUTILUS_SCRIPT_SRC" "$dest_dir/NFC로 변환"
        chmod +x "$dest_dir/NFC로 변환"
        chown -R "$2:$3" "$home/.local"
    }

    install_nautilus_script /etc/skel root root

    getent passwd | awk -F: '$3 >= 1000 && $3 < 60000 { print $1":"$3":"$4":"$6 }' | while IFS=: read -r user uid gid home; do
        if [ -d "$home" ]; then
            install_nautilus_script "$home" "$uid" "$gid"
        fi
    done
fi
